PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

DB_HOST=127.0.0.1
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=rpl_crm

# Optional, comma-separated origins for cross-origin API access.
# Leave empty when the UI and API use the same origin.
CORS_ORIGIN=

# Set the public app URL in production for password reset links.
# If omitted, links use the origin of the password reset request.
FRONTEND_URL=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=Rangs Properties <no-reply@example.com>

# Optional until WhatsApp reminders are configured.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=followup_reminder
